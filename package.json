{
  "name": "eunomia-sync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "pinia": "^3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-vue": "^10",
    "globals": "^16",
    "happy-dom": "^20",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8",
    "vite": "^8.0.16",
    "vitest": "^4",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.5"
  }
}
